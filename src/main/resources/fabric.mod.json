  "authors": [
    "Dalkco"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/farm-rate-counter",
    "sources": "https://github.com/Dalkco11/FarmRateCounter",
    "issues": "https://github.com/Dalkco11/FarmRateCounter/issues"
  },
  "license": "MIT",
  "icon": "assets/farmrate/icon.png",
